# Copiez ce fichier vers .env et adaptez les valeurs. Ne JAMAIS committer .env.

APP_ENV=production
APP_DEBUG=0
APP_URL=https://srv1231763.hstgr.cloud/expositions/
APP_TIMEZONE=Europe/Paris

# Base de données
DB_HOST=mysql_db
DB_PORT=3306
DB_NAME=expositions
DB_USER=expo_user
DB_PASS=changez-moi

# Mail (laisser SMTP_HOST vide en APP_DEBUG=1 : les mails sont loggés, pas envoyés)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM=noreply@expositions.top
MAIL_FROM_NAME=expositions.top

# Secret de signature des flux iCal personnels (générez une chaîne aléatoire longue)
APP_KEY=changez-moi-aussi
